COMPOSE_PROJECT_NAME=mysql-world-python-prod
APP_ENV=production
APP_LOG_LEVEL=info
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=classicmodels_api
MYSQL_DATABASE=classicmodels
MYSQL_ROOT_SECRET_SOURCE=./secrets/prod_mysql_root_password.txt
MYSQL_APP_SECRET_SOURCE=./secrets/prod_mysql_app_password.txt
TLS_CERT_DIR=./certs-prod
