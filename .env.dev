COMPOSE_PROJECT_NAME=mysql-world-python
APP_ENV=development
APP_LOG_LEVEL=debug
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=classicmodels_api
MYSQL_DATABASE=classicmodels
MYSQL_ROOT_SECRET_SOURCE=./secrets/mysql_root_password.txt
MYSQL_APP_SECRET_SOURCE=./secrets/mysql_app_password.txt
TLS_CERT_DIR=./certs
